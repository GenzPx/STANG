# STANG environment template
# Copy this file to .env and adjust values.
# Never commit .env to version control.

# Passphrase used by `stang ... --encrypt --passphrase-env STANG_PASSPHRASE`.
# Generate one with: stang keygen
STANG_PASSPHRASE=change-me

# Raw HMAC integrity key used by `--key-env` (integrity-only mode).
STANG_INTEGRITY_KEY=change-me-too
